{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenDiscogs API",
    "version": "1.0.0",
    "description": "High-performance read-only API for the currently imported public Discogs monthly dump snapshot. Collection resources use stable ascending-ID cursor pagination without exact counts. Nested relation arrays are unordered, and clients must not rely on array position. The service does not call or proxy the Discogs API, perform live hydration, or accept catalog writes."
  },
  "servers": [{"url": "/"}],
  "paths": {
    "/artists": {
      "get": {
        "operationId": "searchArtists",
        "tags": ["artists"],
        "parameters": [
          {"$ref": "#/components/parameters/AfterID"},
          {"$ref": "#/components/parameters/Size"},
          {"$ref": "#/components/parameters/Name"},
          {"$ref": "#/components/parameters/RealName"}
        ],
        "responses": {
          "200": {"description": "Artist page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtistPage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/artists/{id}": {
      "get": {
        "operationId": "getArtist",
        "tags": ["artists"],
        "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {
          "200": {"description": "Artist detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtistDetail"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/artists/{id}/releases": {
      "get": {
        "operationId": "getArtistReleases",
        "tags": ["artists", "releases"],
        "parameters": [
          {"$ref": "#/components/parameters/ID"},
          {"$ref": "#/components/parameters/AfterID"},
          {"$ref": "#/components/parameters/Size"}
        ],
        "responses": {
          "200": {"description": "Artist release page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtistReleasePage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/labels": {
      "get": {
        "operationId": "searchLabels",
        "tags": ["labels"],
        "parameters": [
          {"$ref": "#/components/parameters/AfterID"},
          {"$ref": "#/components/parameters/Size"},
          {"$ref": "#/components/parameters/Name"}
        ],
        "responses": {
          "200": {"description": "Label page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LabelPage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/labels/{id}": {
      "get": {
        "operationId": "getLabel",
        "tags": ["labels"],
        "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {
          "200": {"description": "Label detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LabelDetail"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/labels/{id}/releases": {
      "get": {
        "operationId": "getLabelReleases",
        "tags": ["labels", "releases"],
        "parameters": [
          {"$ref": "#/components/parameters/ID"},
          {"$ref": "#/components/parameters/AfterID"},
          {"$ref": "#/components/parameters/Size"}
        ],
        "responses": {
          "200": {"description": "Label release page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LabelReleasePage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/masters": {
      "get": {
        "operationId": "searchMasters",
        "tags": ["masters"],
        "parameters": [
          {"$ref": "#/components/parameters/AfterID"},
          {"$ref": "#/components/parameters/Size"},
          {"$ref": "#/components/parameters/Title"},
          {"$ref": "#/components/parameters/Year"}
        ],
        "responses": {
          "200": {"description": "Master page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MasterPage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/masters/{id}": {
      "get": {
        "operationId": "getMaster",
        "tags": ["masters"],
        "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {
          "200": {"description": "Master detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MasterDetail"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/masters/{id}/releases": {
      "get": {
        "operationId": "getMasterReleases",
        "tags": ["masters", "releases"],
        "parameters": [
          {"$ref": "#/components/parameters/ID"},
          {"$ref": "#/components/parameters/AfterID"},
          {"$ref": "#/components/parameters/Size"}
        ],
        "responses": {
          "200": {"description": "Master release page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MasterReleasePage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/releases": {
      "get": {
        "operationId": "searchReleases",
        "tags": ["releases"],
        "parameters": [
          {"$ref": "#/components/parameters/AfterID"},
          {"$ref": "#/components/parameters/Size"},
          {"$ref": "#/components/parameters/Title"},
          {"$ref": "#/components/parameters/Country"},
          {"$ref": "#/components/parameters/Year"},
          {"$ref": "#/components/parameters/Month"},
          {"$ref": "#/components/parameters/Master"},
          {"$ref": "#/components/parameters/LabelID"},
          {"$ref": "#/components/parameters/CatalogNumber"},
          {"$ref": "#/components/parameters/IdentifierType"},
          {"$ref": "#/components/parameters/IdentifierValue"}
        ],
        "responses": {
          "200": {"description": "Release page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReleasePage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/releases/{id}": {
      "get": {
        "operationId": "getRelease",
        "tags": ["releases"],
        "parameters": [{"$ref": "#/components/parameters/ID"}],
        "responses": {
          "200": {"description": "Release detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReleaseDetail"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/releases/{id}/tracks": {
      "get": {
        "operationId": "getReleaseTracks",
        "tags": ["releases"],
        "description": "Returns a bounded page of tracks. Physical or response order has no catalog meaning; continue only with next_cursor.",
        "parameters": [
          {"$ref": "#/components/parameters/ID"},
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Size"}
        ],
        "responses": {
          "200": {"description": "Release track page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReleaseTrackPage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/releases/{id}/identifiers": {
      "get": {
        "operationId": "getReleaseIdentifiers",
        "tags": ["releases"],
        "description": "Returns a bounded page of identifiers such as barcodes and matrix or runout values. Continue only with next_cursor.",
        "parameters": [
          {"$ref": "#/components/parameters/ID"},
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Size"}
        ],
        "responses": {
          "200": {"description": "Release identifier page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReleaseIdentifierPage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/snapshot": {
      "get": {
        "operationId": "getSnapshot",
        "tags": ["system"],
        "description": "Reports the currently imported dump date and successful importer provenance for each required catalog entity.",
        "responses": {
          "200": {"description": "Catalog snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CatalogSnapshot"}}}},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "tags": ["system"],
        "responses": {
          "200": {"description": "Build version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Version"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ID": {"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64", "minimum": 1, "maximum": 2147483647}},
      "AfterID": {"name": "after_id", "in": "query", "description": "Return records with an ID greater than this cursor. Omit or use zero for the first page.", "schema": {"type": "integer", "format": "int64", "minimum": 0, "maximum": 2147483647, "default": 0}},
      "Cursor": {"name": "cursor", "in": "query", "description": "Opaque cursor returned as next_cursor by a Release child collection. Omit for the first page.", "schema": {"type": "string"}},
      "Size": {"name": "size", "in": "query", "description": "Number of records to return. Values above 30 are rejected.", "schema": {"type": "integer", "minimum": 1, "maximum": 30, "default": 20}},
      "Name": {"name": "name", "in": "query", "description": "Case-insensitive substring search; 3 to 200 characters.", "schema": {"type": "string", "minLength": 3, "maxLength": 200}},
      "RealName": {"name": "real_name", "in": "query", "description": "Case-insensitive substring search; 3 to 200 characters.", "schema": {"type": "string", "minLength": 3, "maxLength": 200}},
      "Title": {"name": "title", "in": "query", "description": "Case-insensitive substring search; 3 to 200 characters.", "schema": {"type": "string", "minLength": 3, "maxLength": 200}},
      "Country": {"name": "country", "in": "query", "description": "Case-insensitive exact match.", "schema": {"type": "string", "minLength": 1, "maxLength": 255}},
      "Year": {"name": "year", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 32767}},
      "Month": {"name": "month", "in": "query", "description": "Requires year.", "schema": {"type": "integer", "minimum": 1, "maximum": 12}},
      "Master": {"name": "master", "in": "query", "schema": {"type": "boolean"}},
      "LabelID": {"name": "label_id", "in": "query", "description": "Exact catalog-number lookup selector. Requires catno and cannot be combined with other Release filters.", "schema": {"type": "integer", "format": "int64", "minimum": 1, "maximum": 2147483647}},
      "CatalogNumber": {"name": "catno", "in": "query", "description": "Case-sensitive exact catalog number. Requires label_id and cannot be combined with other Release filters.", "schema": {"type": "string", "minLength": 1, "maxLength": 1000}},
      "IdentifierType": {"name": "identifier_type", "in": "query", "description": "Case-insensitive exact identifier type. Requires identifier_value and cannot be combined with other Release filters.", "schema": {"type": "string", "minLength": 1, "maxLength": 255}},
      "IdentifierValue": {"name": "identifier_value", "in": "query", "description": "Case-sensitive exact identifier value. Requires identifier_type and cannot be combined with other Release filters.", "schema": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "responses": {
      "BadRequest": {"description": "Invalid request", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "NotFound": {"description": "Resource absent from the currently imported dump snapshot; this does not assert absence from Discogs", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "GatewayTimeout": {"description": "Database query timeout", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
    },
    "schemas": {
      "NullableString": {"type": ["string", "null"]},
      "NullableInteger": {"type": ["integer", "null"]},
      "NullableBoolean": {"type": ["boolean", "null"]},
      "PageEnvelope": {
        "type": "object",
        "required": ["items", "next_after_id", "has_more", "page_size", "resource_uri"],
        "properties": {
          "next_after_id": {"type": ["integer", "null"], "format": "int64", "minimum": 1, "maximum": 2147483647},
          "has_more": {"type": "boolean"},
          "page_size": {"type": "integer"},
          "resource_uri": {"type": "string"}
        }
      },
      "HashPageEnvelope": {
        "type": "object",
        "required": ["items", "next_cursor", "has_more", "page_size", "resource_uri"],
        "properties": {
          "next_cursor": {"type": ["string", "null"]},
          "has_more": {"type": "boolean"},
          "page_size": {"type": "integer"},
          "resource_uri": {"type": "string"}
        }
      },
      "Artist": {
        "type": "object",
        "required": ["id", "name", "real_name", "profile", "data_quality"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"$ref": "#/components/schemas/NullableString"},
          "real_name": {"$ref": "#/components/schemas/NullableString"},
          "profile": {"$ref": "#/components/schemas/NullableString"},
          "data_quality": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "ArtistReference": {
        "type": "object",
        "required": ["id", "name", "resource_url"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"$ref": "#/components/schemas/NullableString"},
          "resource_url": {"type": "string", "format": "uri"}
        }
      },
      "ArtistDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/Artist"},
          {"type": "object", "required": ["members", "groups", "aliases", "namevariations", "urls", "uri", "release_url"], "properties": {
            "members": {"type": "array", "items": {"$ref": "#/components/schemas/ArtistReference"}},
            "groups": {"type": "array", "items": {"$ref": "#/components/schemas/ArtistReference"}},
            "aliases": {"type": "array", "items": {"$ref": "#/components/schemas/ArtistReference"}},
            "namevariations": {"type": "array", "items": {"type": "string"}},
            "urls": {"type": "array", "items": {"type": "string"}},
            "uri": {"type": "string", "format": "uri"},
            "release_url": {"type": "string", "format": "uri"}
          }}
        ]
      },
      "ArtistRelease": {
        "allOf": [
          {"$ref": "#/components/schemas/Release"},
          {"type": "object", "required": ["role", "resource_url"], "properties": {
            "role": {"$ref": "#/components/schemas/NullableString"},
            "resource_url": {"type": "string", "format": "uri"}
          }}
        ]
      },
      "Label": {
        "type": "object",
        "required": ["id", "contact_info", "data_quality", "name", "profile"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "contact_info": {"$ref": "#/components/schemas/NullableString"},
          "data_quality": {"$ref": "#/components/schemas/NullableString"},
          "name": {"$ref": "#/components/schemas/NullableString"},
          "profile": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "LabelReference": {
        "type": "object",
        "required": ["id", "name", "resource_url"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"$ref": "#/components/schemas/NullableString"},
          "resource_url": {"type": "string", "format": "uri"}
        }
      },
      "LabelDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/Label"},
          {"type": "object", "required": ["parent_label", "sublabels", "urls", "uri", "release_url"], "properties": {
            "parent_label": {"oneOf": [{"$ref": "#/components/schemas/LabelReference"}, {"type": "null"}]},
            "sublabels": {"type": "array", "items": {"$ref": "#/components/schemas/LabelReference"}},
            "urls": {"type": "array", "items": {"type": "string"}},
            "uri": {"type": "string", "format": "uri"},
            "release_url": {"type": "string", "format": "uri"}
          }}
        ]
      },
      "LabelRelease": {
        "type": "object",
        "required": ["id", "artist", "title", "year", "status", "catnos", "format"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "artist": {"$ref": "#/components/schemas/NullableString"},
          "title": {"$ref": "#/components/schemas/NullableString"},
          "year": {"$ref": "#/components/schemas/NullableInteger"},
          "status": {"$ref": "#/components/schemas/NullableString"},
          "catnos": {"type": "array", "items": {"type": "string"}},
          "format": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "Master": {
        "type": "object",
        "required": ["id", "data_quality", "title", "released_year"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "data_quality": {"$ref": "#/components/schemas/NullableString"},
          "title": {"$ref": "#/components/schemas/NullableString"},
          "released_year": {"$ref": "#/components/schemas/NullableInteger"}
        }
      },
      "MasterDetail": {
        "type": "object",
        "required": ["id", "title", "data_quality", "main_release", "year", "genres", "styles", "artists", "videos"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "title": {"$ref": "#/components/schemas/NullableString"},
          "data_quality": {"$ref": "#/components/schemas/NullableString"},
          "main_release": {"$ref": "#/components/schemas/NullableInteger"},
          "year": {"$ref": "#/components/schemas/NullableInteger"},
          "genres": {"type": "array", "items": {"type": "string"}},
          "styles": {"type": "array", "items": {"type": "string"}},
          "artists": {"type": "array", "items": {"$ref": "#/components/schemas/ArtistReference"}},
          "videos": {"type": "array", "items": {"$ref": "#/components/schemas/Video"}}
        }
      },
      "MasterRelease": {
        "type": "object",
        "required": ["id", "title", "artist", "artist_id", "year", "resource_url"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "title": {"$ref": "#/components/schemas/NullableString"},
          "artist": {"type": "array", "items": {"type": "string"}},
          "artist_id": {"type": "array", "items": {"type": "integer", "format": "int64"}},
          "year": {"$ref": "#/components/schemas/NullableInteger"},
          "resource_url": {"type": "string", "format": "uri"}
        }
      },
      "Release": {
        "type": "object",
        "required": ["id", "title", "country", "data_quality", "released_year", "released_month", "released_day", "listed_release_date", "is_master", "master_id", "notes", "status"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "title": {"$ref": "#/components/schemas/NullableString"},
          "country": {"$ref": "#/components/schemas/NullableString"},
          "data_quality": {"$ref": "#/components/schemas/NullableString"},
          "released_year": {"$ref": "#/components/schemas/NullableInteger"},
          "released_month": {"$ref": "#/components/schemas/NullableInteger"},
          "released_day": {"$ref": "#/components/schemas/NullableInteger"},
          "listed_release_date": {"$ref": "#/components/schemas/NullableString"},
          "is_master": {"$ref": "#/components/schemas/NullableBoolean"},
          "master_id": {"$ref": "#/components/schemas/NullableInteger"},
          "notes": {"$ref": "#/components/schemas/NullableString"},
          "status": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "ReleaseArtist": {
        "type": "object",
        "required": ["id", "name", "role", "resource_url"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"$ref": "#/components/schemas/NullableString"},
          "role": {"$ref": "#/components/schemas/NullableString"},
          "resource_url": {"type": "string", "format": "uri"}
        }
      },
      "ReleaseLabel": {
        "type": "object",
        "required": ["id", "name", "catno", "resource_url"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"$ref": "#/components/schemas/NullableString"},
          "catno": {"$ref": "#/components/schemas/NullableString"},
          "resource_url": {"type": "string", "format": "uri"}
        }
      },
      "ReleaseFormat": {
        "type": "object",
        "required": ["name", "qty", "descriptions"],
        "properties": {
          "name": {"$ref": "#/components/schemas/NullableString"},
          "qty": {"$ref": "#/components/schemas/NullableString"},
          "descriptions": {"type": "array", "items": {"type": "string"}}
        }
      },
      "Video": {
        "type": "object",
        "required": ["title", "url", "description"],
        "properties": {
          "title": {"$ref": "#/components/schemas/NullableString"},
          "url": {"$ref": "#/components/schemas/NullableString"},
          "description": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "ReleaseDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/Release"},
          {"type": "object", "required": ["artists", "labels", "companies", "formats", "styles", "genres", "videos"], "properties": {
            "artists": {"type": "array", "items": {"$ref": "#/components/schemas/ReleaseArtist"}},
            "labels": {"type": "array", "items": {"$ref": "#/components/schemas/ReleaseLabel"}},
            "companies": {"type": "array", "items": {"$ref": "#/components/schemas/ReleaseLabel"}},
            "formats": {"type": "array", "items": {"$ref": "#/components/schemas/ReleaseFormat"}},
            "styles": {"type": "array", "items": {"type": "string"}},
            "genres": {"type": "array", "items": {"type": "string"}},
            "videos": {"type": "array", "items": {"$ref": "#/components/schemas/Video"}}
          }}
        ]
      },
      "ReleaseTrack": {
        "type": "object",
        "required": ["duration", "position", "title"],
        "properties": {
          "duration": {"$ref": "#/components/schemas/NullableString"},
          "position": {"$ref": "#/components/schemas/NullableString"},
          "title": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "ReleaseIdentifier": {
        "type": "object",
        "required": ["description", "type", "value"],
        "properties": {
          "description": {"$ref": "#/components/schemas/NullableString"},
          "type": {"$ref": "#/components/schemas/NullableString"},
          "value": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "SnapshotEntity": {
        "type": "object",
        "required": ["entity_type", "status", "dump_date", "applied_at", "processor", "processor_version"],
        "properties": {
          "entity_type": {"type": "string", "enum": ["artist", "label", "master", "release"]},
          "status": {"type": "string", "enum": ["bootstrap_pending", "importing", "ready", "failed"]},
          "dump_date": {"type": ["string", "null"], "format": "date"},
          "applied_at": {"type": ["string", "null"], "format": "date-time"},
          "processor": {"$ref": "#/components/schemas/NullableString"},
          "processor_version": {"$ref": "#/components/schemas/NullableString"}
        }
      },
      "CatalogSnapshot": {
        "type": "object",
        "required": ["ready", "status", "updated_at", "entities"],
        "properties": {
          "ready": {"type": "boolean"},
          "status": {"type": "string", "enum": ["bootstrap_pending", "importing", "ready", "failed"]},
          "updated_at": {"type": "string", "format": "date-time"},
          "entities": {"type": "array", "items": {"$ref": "#/components/schemas/SnapshotEntity"}, "minItems": 4, "maxItems": 4}
        }
